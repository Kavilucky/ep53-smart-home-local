# Пример значений, которые вы подставляете сами (например, в secrets.yaml Home Assistant или в конфигурацию Zigbee2MQTT).
# Скопируйте файл в .env или используйте как памятку. Реальных паролей и ключей здесь нет и быть не должно.
# Не публикуйте ваш .env, secrets.yaml и network_key.

# Брокер Mosquitto в Home Assistant OS
MQTT_SERVER=mqtt://core-mosquitto:1883
MQTT_USER=ВАШ-ПОЛЬЗОВАТЕЛЬ-MQTT
MQTT_PASSWORD=ВАШ-ПАРОЛЬ-MQTT

# Адрес вашего сервера Home Assistant (постоянный адрес, закреплённый в роутере)
HA_URL=http://homeassistant.local:8123

# Путь к Zigbee-стику: Настройки → Система → Оборудование → Системное оборудование
ZIGBEE_PORT=/dev/serial/by-id/ВАШ-СТИК

# Тип адаптера: ember (ZBDongle-E) или zstack (ZBDongle-P)
ZIGBEE_ADAPTER=ember

# Zigbee-канал: 11, 15, 20 или 25 (с учётом вашей сети Wi-Fi 2,4 ГГц)
ZIGBEE_CHANNEL=15
